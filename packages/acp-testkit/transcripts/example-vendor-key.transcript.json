{
  "version": 1,
  "name": "example: vendor wait_for_key and file read during prompt",
  "options": {
    "agent": { "name": "example-agent", "identity": "example.test" },
    "client": { "name": "test-client", "version": "0.1.0" }
  },
  "workbench": {
    "project": { "path": "/repo" },
    "asks": {
      "key": [{ "key": "y" }]
    },
    "services": {
      "files": {
        "readText": [{ "ok": "hello from disk" }]
      },
      "presentation": {
        "capabilities": [{ "ok": { "theme": "dark" } }]
      },
      "tools": {
        "list": [{ "ok": [] }],
        "mcpServers": [{ "ok": [] }]
      }
    }
  },
  "steps": [
    {
      "action": "start",
      "wire": [
        {
          "dir": "client",
          "msg": { "id": 0, "method": "initialize", "params": { "protocolVersion": 1 } },
          "match": {
            "params": {
              "clientCapabilities": {
                "_meta": { "deft.co": { "waitForKey": {} } }
              }
            }
          }
        },
        {
          "dir": "agent",
          "msg": {
            "id": 0,
            "result": {
              "protocolVersion": 1,
              "agentInfo": { "name": "example-agent", "version": "1.0.0" },
              "agentCapabilities": { "_meta": { "deft.co": {} } }
            }
          }
        },
        {
          "dir": "client",
          "msg": { "id": 1, "method": "session/new", "params": { "cwd": "/repo", "mcpServers": [] } }
        },
        {
          "dir": "agent",
          "msg": { "id": 1, "result": { "sessionId": "sess-1" } }
        }
      ]
    },
    {
      "action": "sendPrompt",
      "prompt": "Check file and ask for key",
      "expectResult": "end_turn",
      "wire": [
        {
          "dir": "client",
          "msg": { "id": 2, "method": "session/prompt", "params": { "sessionId": "sess-1" } }
        },
        {
          "dir": "agent",
          "msg": {
            "id": 10,
            "method": "fs/read_text_file",
            "params": { "sessionId": "sess-1", "path": "README.md" }
          }
        },
        {
          "dir": "client",
          "msg": { "id": 10, "result": { "content": "hello from disk" } }
        },
        {
          "dir": "agent",
          "msg": {
            "id": 11,
            "method": "deft.co/wait_for_key",
            "params": {
              "message": "Continue?",
              "keys": [
                { "key": "y", "label": "Yes" },
                { "key": "n", "label": "No" }
              ]
            }
          }
        },
        {
          "dir": "client",
          "msg": { "id": 11, "result": { "outcome": "pressed", "key": "y" } }
        },
        {
          "dir": "agent",
          "msg": {
            "method": "session/update",
            "params": {
              "sessionId": "sess-1",
              "update": {
                "sessionUpdate": "agent_message_chunk",
                "content": { "type": "text", "text": "Done." }
              }
            }
          }
        },
        {
          "dir": "agent",
          "msg": { "id": 2, "result": { "stopReason": "end_turn" } }
        }
      ]
    },
    {
      "action": "stop"
    }
  ],
  "expected": [
    {
      "kind": "service",
      "workbench": "main",
      "service": "files",
      "method": "readText",
      "args": { "sessionId": "sess-1", "path": "README.md" },
      "result": "hello from disk"
    },
    {
      "kind": "ask",
      "workbench": "main",
      "askKind": "key",
      "request": {
        "message": "Continue?",
        "keys": [
          { "key": "y", "label": "Yes" },
          { "key": "n", "label": "No" }
        ]
      },
      "answer": { "key": "y" }
    },
    {
      "kind": "event",
      "workbench": "main",
      "event": { "type": "message", "delta": "Done.", "text": "Done." }
    }
  ]
}
