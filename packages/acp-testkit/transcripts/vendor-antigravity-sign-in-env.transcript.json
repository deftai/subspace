{
  "version": 1,
  "name": "antigravity: sign-in with key from extra env",
  "options": {
    "agent": {
      "name": "Antigravity",
      "identity": "antigravity.google"
    },
    "client": {
      "name": "deft-console",
      "version": "0.0.0-transcript"
    }
  },
  "workbench": {
    "project": {
      "path": "/tmp-oracle/project",
      "env": {
        "GEMINI_API_KEY": "key-1"
      },
      "settings": {
        "agent.display_tools": false
      }
    },
    "asks": {
      "sign_in": [
        {
          "methodId": "gemini-api-key"
        }
      ]
    },
    "services": {
      "tools": {
        "list": [
          {
            "ok": null
          }
        ],
        "call": [
          {
            "error": "tools turned off"
          }
        ]
      },
      "presentation": {
        "capabilities": [
          {
            "ok": {}
          }
        ]
      }
    }
  },
  "steps": [
    {
      "action": "start",
      "wire": [
        {
          "dir": "client",
          "msg": {
            "jsonrpc": "2.0",
            "method": "initialize",
            "params": {
              "protocolVersion": 1,
              "clientCapabilities": {
                "fs": {
                  "readTextFile": true,
                  "writeTextFile": true
                },
                "terminal": true,
                "session": {
                  "configOptions": {
                    "boolean": {}
                  }
                },
                "elicitation": {
                  "form": {},
                  "url": {}
                },
                "auth": {
                  "terminal": true
                },
                "_meta": {
                  "terminal_output": true,
                  "terminal_output_delta": true,
                  "promptSuggestions": true,
                  "deft.co": {
                    "waitForKey": {},
                    "display": {
                      "mermaid": {}
                    }
                  }
                },
                "subagents": {}
              },
              "clientInfo": {
                "name": "Deft-Console",
                "title": "Deft Console",
                "version": "9.9.9"
              }
            },
            "id": 1
          },
          "t": 0,
          "match": {
            "params": {
              "clientCapabilities": {
                "_meta": {
                  "deft.co": {
                    "waitForKey": {}
                  },
                  "terminal_output": true,
                  "terminal_output_delta": true,
                  "promptSuggestions": true
                }
              }
            }
          }
        },
        {
          "dir": "agent",
          "msg": {
            "jsonrpc": "2.0",
            "id": 1,
            "result": {
              "protocolVersion": 1,
              "agentCapabilities": {
                "loadSession": false,
                "promptCapabilities": {
                  "audio": false,
                  "embeddedContext": false,
                  "image": false
                }
              },
              "authMethods": [
                {
                  "id": "gemini-api-key",
                  "name": "Gemini key",
                  "description": "Enter a key",
                  "type": "agent"
                }
              ]
            }
          },
          "t": 1
        },
        {
          "dir": "client",
          "msg": {
            "jsonrpc": "2.0",
            "method": "session/new",
            "params": {
              "cwd": "/tmp-oracle/project",
              "mcpServers": []
            },
            "id": 2
          },
          "t": 2
        },
        {
          "dir": "agent",
          "msg": {
            "jsonrpc": "2.0",
            "id": 2,
            "error": {
              "code": -32000,
              "message": "Not signed in"
            }
          },
          "t": 3
        },
        {
          "dir": "client",
          "msg": {
            "jsonrpc": "2.0",
            "method": "authenticate",
            "params": {
              "methodId": "gemini-api-key",
              "_meta": {
                "apiKey": "key-1"
              }
            },
            "id": 3
          },
          "t": 4
        },
        {
          "dir": "agent",
          "msg": {
            "jsonrpc": "2.0",
            "id": 3,
            "result": {}
          },
          "t": 5
        },
        {
          "dir": "client",
          "msg": {
            "jsonrpc": "2.0",
            "method": "session/new",
            "params": {
              "cwd": "/tmp-oracle/project",
              "mcpServers": []
            },
            "id": 4
          },
          "t": 6
        },
        {
          "dir": "agent",
          "msg": {
            "jsonrpc": "2.0",
            "id": 4,
            "result": {
              "sessionId": "sess-1"
            }
          },
          "t": 7
        }
      ]
    },
    {
      "action": "stop"
    }
  ],
  "expected": [
    {
      "kind": "service",
      "workbench": "main",
      "service": "presentation",
      "method": "capabilities",
      "result": {}
    },
    {
      "kind": "service",
      "workbench": "main",
      "service": "tools",
      "method": "list",
      "result": null
    },
    {
      "kind": "ask",
      "askKind": "sign_in",
      "request": {
        "methods": [
          {
            "id": "gemini-api-key",
            "name": "Gemini key",
            "description": "Enter a key",
            "type": "agent"
          }
        ],
        "message": "Not signed in"
      },
      "answer": {
        "methodId": "gemini-api-key"
      }
    }
  ],
  "expectSessionId": "sess-1"
}
