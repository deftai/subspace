{
  "name": "@deft-subspace/claude",
  "version": "0.0.0-experiment",
  "description": "A Claude model for Subspace agents: modelAgent({ model: claude() }) is an ACP agent backed by the Claude API.",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=22.19"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --conditions=source --test --test-force-exit test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@deft-subspace/acp": "workspace:*"
  },
  "devDependencies": {
    "@deft-subspace/kernel": "workspace:*"
  }
}
