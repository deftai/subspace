{
  "name": "subspace",
  "private": true,
  "type": "module",
  "description": "Deft Subspace: ACP for apps and agents (kernel, acp, testkit, devtools)",
  "scripts": {
    "build": "pnpm --filter \"@deft-subspace/*\" run build",
    "typecheck": "pnpm --filter \"@deft-subspace/*\" run typecheck",
    "test": "pnpm --filter \"@deft-subspace/*\" run test",
    "proto:build": "pnpm run build",
    "proto:typecheck": "pnpm run typecheck",
    "proto:test": "pnpm run test"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deftai/subspace.git"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22.19.0"
  }
}
